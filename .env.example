# PostgreSQL
POSTGRES_USER=alkhal
POSTGRES_PASSWORD=alkhal_dev_password
POSTGRES_DB=alkhal
POSTGRES_PORT=5433
DATABASE_URL=postgresql://alkhal:alkhal_dev_password@127.0.0.1:5433/alkhal?schema=public

# Redis (optional — reserved for future job queues)
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_PREFIX=api
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed owner (development only)
SEED_OWNER_EMAIL=owner@alkhal.local
SEED_OWNER_PASSWORD=ChangeMe!123

# Web / mobile
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000
# Optional extra CORS origins in production, comma-separated
# CORS_ORIGINS=https://pos.example.com
# Physical device: set to your PC LAN IP, e.g. http://192.168.1.10:4000/api
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api
