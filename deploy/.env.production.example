# Copy to /var/www/alkhal/.env and fill secrets
# Also symlink/copy to packages/database/.env for Prisma

# PostgreSQL (dedicated user/db — does not touch other projects)
POSTGRES_USER=alkhal
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=alkhal
# Host port if using Docker for this project only (avoid conflict with other DBs)
POSTGRES_PORT=5435
DATABASE_URL=postgresql://alkhal:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5435/alkhal?schema=public

# Redis optional
REDIS_URL=redis://127.0.0.1:6380

# API (internal)
API_PORT=4005
API_PREFIX=api
NODE_ENV=production
WEB_ORIGIN=https://adminalkhal.qmenussy.com
CORS_ORIGINS=https://adminalkhal.qmenussy.com

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# First owner (seed once)
SEED_OWNER_EMAIL=owner@alkhal.local
SEED_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD

# Web (must be set BEFORE pnpm --filter @alkhal/web build)
NEXT_PUBLIC_API_URL=https://apialkhal.qmenussy.com/api
NEXT_PUBLIC_WS_URL=https://apialkhal.qmenussy.com
PORT=4006
